# Copie para .env (cp .env.example .env) e ajuste os valores.
# O .env é lido pelo docker compose; nunca versione o .env real.

# Chave secreta do Django. Gere uma nova com:
# python -c "from django.core.management.utils import \
# get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria

# True/False. Com False, ALLOWED_HOSTS precisa estar preenchido.
DEBUG=False

# Hosts separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Caminho do banco SQLite. No container, /app/data é o volume nomeado.
# Sem esta variável, o padrão é db.sqlite3 na raiz do projeto.
SQLITE_PATH=/app/data/db.sqlite3

# Análise financeira com IA (OpenAI via LangChain).
# Chave da API da OpenAI. Vazia: a análise com IA fica desativada e o
# restante do sistema funciona normalmente. Nunca versione a chave real.
OPENAI_API_KEY=

# Modelo usado pelo ChatOpenAI.
OPENAI_MODEL=gpt-6-luna

# Timeout, em segundos, de cada requisição à OpenAI.
OPENAI_TIMEOUT=60

# Novas tentativas automáticas do cliente OpenAI (rede, 429, 5xx).
OPENAI_MAX_RETRIES=2

# Rastreamento do LangSmith: deve ficar desligado (nenhum dado financeiro
# é enviado a serviços de observabilidade externos).
LANGSMITH_TRACING=false
